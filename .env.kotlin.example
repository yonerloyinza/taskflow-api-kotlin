# ==========================================
# taskflow-api-kotlin — variables de entorno (VPS: /opt/taskflow/.env.kotlin)
# ==========================================
APP_NAME=taskflow-api-kotlin
ENVIRONMENT=production
PORT=3000

# CORS: "*" o lista de orígenes separados por coma
CORS_ORIGINS=*

# Rate limiting (plugin RateLimit de Ktor)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Base de datos PostgreSQL Cloud (vendor-agnostic)
# DATABASE_URL: runtime (pooler 6543 si el proveedor lo expone)
# DIRECT_URL: migraciones Flyway (puerto 5432)
DB_MAX_CONNECTIONS=10
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/insforge?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/insforge?sslmode=require